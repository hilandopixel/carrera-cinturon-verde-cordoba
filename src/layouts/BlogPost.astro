---
import '../styles/global.css';

const { title, description, pubDate, author, cover, coverAlt } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "author": { "@type": "Person", "name": author || "Carrera Cinturón Verde" },
  "datePublished": pubDate,
  "image": cover ? new URL(cover, Astro.url).href : undefined,
  "mainEntityOfPage": canonicalURL.href
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Carrera Cinturón Verde de Córdoba</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  {cover && <meta property="og:image" content={new URL(cover, Astro.url).href} />}

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="min-h-screen flex flex-col bg-stone-50">

  <!-- Header Flotante -->
  <header class="bg-emerald-950/90 backdrop-blur-md text-white shadow-lg border-b border-emerald-700/50 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-extrabold tracking-tight uppercase text-emerald-400 hover:text-emerald-300 transition-colors">
        🌿 Cinturón Verde Córdoba
      </a>
      <nav class="space-x-6 text-sm font-semibold">
        <a href="/" class="hover:text-emerald-300 transition-colors">Inicio</a>
        <a href="/#articulos" class="hover:text-emerald-300 transition-colors">Artículos</a>
      </nav>
    </div>
  </header>

  <!-- SECCIÓN HERO COVER (Min Height 100vh con imagen de fondo completa) -->
  <section class="relative w-full min-h-screen flex items-end justify-center overflow-hidden bg-emerald-950">
    {cover && (
      <img 
        src={cover} 
        alt={coverAlt || title} 
        class="absolute inset-0 w-full h-full object-cover object-center opacity-40 filter brightness-90"
      />
    )}
    <!-- Gradiente de superposición para legibilidad -->
    <div class="absolute inset-0 bg-gradient-to-t from-emerald-950 via-emerald-950/40 to-transparent"></div>

    <!-- Contenido del título sobre la imagen -->
    <div class="relative z-10 max-w-4xl mx-auto px-6 pb-16 pt-32 text-center text-white">
      <div class="inline-flex items-center space-x-2 text-xs md:text-sm font-bold uppercase tracking-widest text-emerald-300 bg-emerald-900/80 px-4 py-1.5 rounded-full border border-emerald-600/50 backdrop-blur-sm mb-6">
        <span>Trail & MTB Córdoba</span>
        <span>•</span>
        <time datetime={pubDate}>{pubDate}</time>
      </div>
      <h1 class="text-3xl md:text-6xl font-black text-white leading-tight mb-6 drop-shadow-md">
        {title}
      </h1>
      <p class="text-lg md:text-2xl text-emerald-100/90 font-light max-w-3xl mx-auto leading-relaxed drop-shadow">
        {description}
      </p>

      {author && (
        <div class="mt-8 text-sm text-emerald-300/80 font-medium">
          Por: <span class="text-emerald-200 font-semibold">{author}</span>
        </div>
      )}
    </div>
  </section>

  <!-- Cuerpo del Artículo -->
  <main class="flex-grow max-w-4xl mx-auto px-6 py-16 w-full">
    <article class="bg-white p-8 md:p-14 rounded-2xl shadow-xl border border-emerald-100/80 -mt-20 relative z-20">
      <div class="prose prose-emerald lg:prose-xl max-w-none text-stone-700 leading-relaxed 
                  prose-headings:text-emerald-950 prose-headings:font-bold 
                  prose-a:text-emerald-700 hover:prose-a:text-emerald-500
                  prose-img:rounded-xl prose-img:shadow-md prose-img:border prose-img:border-emerald-100">
        <slot />
      </div>
    </article>
  </main>

  <!-- Footer -->
  <footer class="bg-stone-900 text-stone-300 py-10 border-t border-emerald-800 mt-12">
    <div class="max-w-5xl mx-auto px-6 text-center text-sm">
      <p class="font-medium text-emerald-400 mb-2">Carrera Cinturón Verde de Córdoba — Trail Running & MTB</p>
      <p class="text-stone-500">© {new Date().getFullYear()} Generado en HTML Estático Optimizado para SEO.</p>
    </div>
  </footer>

</body>
</html>