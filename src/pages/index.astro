---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Carrera Cinturón Verde de Córdoba | Trail Running y MTB</title>
  <meta name="description" content="Sitio oficial con artículos, consejos de preparación y novedades sobre la Carrera Cinturón Verde de Córdoba." />
</head>
<body class="min-h-screen flex flex-col bg-stone-50">

  <!-- Header Hero -->
  <header class="bg-emerald-950 text-white border-b-4 border-emerald-600 py-20 px-6 text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-emerald-900/30 backdrop-blur-3xl"></div>
    <div class="max-w-4xl mx-auto relative z-10">
      <span class="inline-block px-4 py-1.5 bg-emerald-800/80 text-emerald-200 text-xs font-bold rounded-full uppercase tracking-wider mb-6 border border-emerald-600">
        Edición Trail & MTB Córdoba
      </span>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-6 text-white leading-tight">
        Carrera Cinturón Verde de Córdoba
      </h1>
      <p class="text-emerald-100 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed">
        Blog oficial con guías técnicas, estrategia de recorrido y preparación para la prueba emblemática de la Sierra de Córdoba.
      </p>
    </div>
  </header>

  <!-- Main Content -->
  <main id="articulos" class="flex-grow max-w-6xl mx-auto px-6 py-16 w-full">
    <h2 class="text-3xl font-extrabold text-emerald-950 mb-10 border-b-2 border-emerald-600 pb-3 inline-block">
      Últimos Artículos y Guías
    </h2>

    <div class="grid gap-10 md:grid-cols-2">
      {posts.map((post) => (
        <article class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-emerald-100 overflow-hidden flex flex-col group">
          <div class="relative h-64 overflow-hidden bg-emerald-950">
            <img 
              src={post.data.cover || "https://images.unsplash.com/photo-1544197150-b99a580bb7a8?q=80&w=1600&auto=format&fit=crop"} 
              alt={post.data.coverAlt || post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
            />
            <div class="absolute top-4 left-4 bg-emerald-950/80 backdrop-blur-md text-emerald-300 text-xs font-bold px-3 py-1 rounded-full border border-emerald-600/50">
              {post.data.pubDate}
            </div>
          </div>
          <div class="p-8 flex flex-col justify-between flex-grow">
            <div>
              <h3 class="text-2xl font-bold text-emerald-950 mb-3 group-hover:text-emerald-700 transition-colors leading-snug">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              <p class="text-stone-600 text-base line-clamp-3 mb-6 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <a href={`/blog/${post.slug}`} class="inline-flex items-center text-emerald-800 font-bold text-sm hover:text-emerald-600 transition-colors mt-auto">
              Leer artículo completo →
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <footer class="bg-stone-900 text-stone-300 py-10 border-t border-emerald-800">
    <div class="max-w-5xl mx-auto px-6 text-center text-sm">
      <p class="font-medium text-emerald-400 mb-1">Carrera Cinturón Verde de Córdoba</p>
      <p class="text-stone-500">© {new Date().getFullYear()} HTML Estático Optimizado para SEO en Vercel.</p>
    </div>
  </footer>

</body>
</html>