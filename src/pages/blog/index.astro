---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog | Carrera Cinturón Verde de Córdoba</title>
</head>
<body class="bg-stone-50 min-h-screen flex flex-col">

  <header class="bg-emerald-950 text-white border-b-4 border-emerald-600 py-12 px-6 text-center">
    <div class="max-w-4xl mx-auto">
      <a href="/" class="text-xs uppercase font-bold text-emerald-400 hover:text-emerald-300">← Volver al Inicio</a>
      <h1 class="text-3xl md:text-5xl font-black mt-2">Artículos del Cinturón Verde</h1>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-12 flex-grow w-full">
    <div class="grid gap-8 md:grid-cols-2">
      {posts.map((post) => {
        const dateObj = new Date(post.data.pubDate);
        const isoDate = !isNaN(dateObj.getTime()) ? dateObj.toISOString() : post.data.pubDate;

        return (
          <article class="bg-white rounded-xl shadow-sm border border-emerald-100 overflow-hidden flex flex-col">
            {post.data.cover && (
              <img 
                src={post.data.cover} 
                alt={post.data.coverAlt || post.data.title} 
                class="w-full h-48 object-cover"
              />
            )}
            <div class="p-6 flex flex-col justify-between flex-grow">
              <div>
                <time datetime={isoDate} class="text-xs font-bold text-emerald-700 uppercase">
                  {post.data.pubDate}
                </time>
                <h2 class="text-xl font-bold text-emerald-950 mt-2 mb-2">
                  <a href={`/blog/${post.slug}`} class="hover:text-emerald-700 transition-colors">
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-stone-600 text-sm line-clamp-3">{post.data.description}</p>
              </div>
              <a href={`/blog/${post.slug}`} class="inline-flex items-center text-emerald-800 font-bold text-sm hover:text-emerald-600 transition-colors mt-4">
                Leer artículo completo →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>

  <footer class="bg-stone-900 text-stone-300 py-8 border-t border-emerald-800 mt-12 text-center text-sm">
    <p>© {new Date().getFullYear()} Carrera Cinturón Verde de Córdoba</p>
  </footer>

</body>
</html>